{
  "name": "@diaryx/fig",
  "version": "5.1.2",
  "description": "JSON, JSONC, JSON5, YAML, TOML, INI, dotenv, .properties, NestedText, ZON, plist and fig parsing, comment-preserving editing, and cross-format serialization: a Zig core compiled to WebAssembly, with each format a JavaScript language you import only if you use it.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./helper": {
      "fig-source": "./src/helper.ts",
      "types": "./dist/helper.d.ts",
      "default": "./dist/helper.js"
    },
    "./kit": {
      "fig-source": "./kit/index.js",
      "types": "./dist/kit/index.d.ts",
      "default": "./kit/index.js"
    },
    "./kit/*": {
      "fig-source": "./kit/*.js",
      "types": "./dist/kit/*.d.ts",
      "default": "./kit/*.js"
    },
    "./languages/*": {
      "fig-source": "./languages/*.js",
      "types": "./dist/languages/*.d.ts",
      "default": "./languages/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "kit",
    "languages",
    "src",
    "!src/wasm-bytes.ts",
    "!dist/wasm-bytes.js.map",
    "!dist/wasm-bytes.d.ts.map",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "json",
    "jsonc",
    "json5",
    "yaml",
    "toml",
    "zon",
    "config",
    "parser",
    "frontmatter",
    "comment-preserving",
    "cross-format",
    "webassembly",
    "wasm"
  ],
  "author": "Adam Harris <amh421@icloud.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/diaryx-org/fig/blob/main/docs/typescript.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diaryx-org/fig.git",
    "directory": "bindings/typescript"
  },
  "bugs": {
    "url": "https://github.com/diaryx-org/fig/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.json && tsc -p tsconfig.languages.json && node scripts/drop-wasm-bytes-maps.mjs",
    "prepack": "node scripts/vendor-publish-files.mjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "tsc -p tsconfig.test.json && node --conditions=fig-source --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
