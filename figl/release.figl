name = Release (crate)

# Publish the crates.io crates (fig-kit and fig-core, from rust/; fig and
# fig-macros, from bindings/rust; and each language's crate, from
# languages/<name>/), all members of the repository's one Cargo workspace.
# The macOS and Linux CLI binaries + Homebrew tap bump are a separate
# workflow (homebrew.yml); Windows/WASI CLI binaries are release-binaries.yml.
#
# The two npm packages (bindings/typescript's @diaryx/fig and
# bindings/wasi's @diaryx/fig-wasi) live in their own files —
# release-npm.figl and release-npm-wasi.figl — split out from this one so
# each publish, with its own required secret, can run (and be re-triggered)
# independently of the others.
#
# Runs on the `v*.*.*` tag, like every release workflow here — one tag
# releases every artifact at fig's one version (see "Release tagging" in
# docs/VERSIONING.md) — and by hand via `workflow_dispatch`, which runs it
# unconditionally. The crate carries the `license`, `description`, and
# `readme` crates.io needs (the README and license text are vendored in from
# the repo root by the `cargo xtask vendor` step that runs before `cargo
# publish`).
#
# It publishes the version Cargo.toml carries, which the checks below hold to
# the tag, and no-ops if that exact version is already out.
#
# Required repository secret:
# CARGO_REGISTRY_TOKEN  — crates.io API token with publish rights to every
#                         fig* crate, new ones included (already set). Not
#                         crates.io Trusted Publishing: it needs an entry per
#                         crate, made by hand once the crate exists, and the
#                         graph gains a crate with each new language or target.
on
> workflow_dispatch = {}
> push.tags = [v*.*.*]

permissions.contents = read

jobs.crate
> name = Publish crate (crates.io)
> runs-on = ubuntu-latest

jobs.crate.steps[]
> uses = actions/checkout@v7
> with.fetch-depth = 0
+
> uses = dtolnay/rust-toolchain@stable
+
> # Every file carrying fig's one version agrees with the workspace's
> # Cargo.toml, and the tag names that version: a tag that does not would
> # publish a package under a number the release did not cut.
> name = Verify every file carries the one version
> run = cargo xtask version-check
+
> name = Verify tag matches the version
> if = github.ref_type == 'tag'
> run = '''
want=$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\([^"]*\)"$/\1/p' Cargo.toml)
tag="${GITHUB_REF_NAME#v}"
if [ "$want" != "$tag" ]; then
  echo "::error::tag $GITHUB_REF_NAME ($tag) != Cargo.toml version ($want)"
  exit 1
fi
echo "version $want matches tag $GITHUB_REF_NAME"

'''
+
> # --all-features so the serde- and derive-gated integration tests also run
> # (they are not in the default feature set).
> run = cargo test --workspace --all-features --locked
+
> # Fans the root LICENSE files out into each crate dir (and the README into
> # fig's) — must run before publishing so the license text is present in
> # every packaged tarball.
> name = Vendor the licenses into the crates
> run = cargo xtask vendor
+
> # Publish the whole graph bottom-up — crates.io rejects an upload whose
> # dependencies aren't already indexed, so the order is:
> #   fig-kit -> fig-core -> fig-macros -> fig -> each language (fig-json, ...),
> #   which depends on fig-kit and, behind its default `fig` feature, on fig
> # (fig-core's and fig's dev-dependencies on the languages are by path alone,
> # so `cargo publish` drops them.) fig-cli, fig-capi, fig-conform and the
> # rest of the workspace's tooling are not published.
> # Two hazards this loop survives, both worst on the FIRST release (all crates
> # brand new):
> #   * crates.io throttles *new-crate* creation to a small burst (~5) then a slow
> #     refill; publishing >5 first-time crates trips a 429, so we wait out one
> #     refill window (~11 min) and retry. Later
> #     releases publish new *versions* (far higher limit), so this matters once
> #     per new crate.
> #   * idempotent: an "already uploaded/exists" response counts as success, so a
> #     re-run after a partial publish skips the crates that already landed.
> name = Publish to crates.io (bottom-up)
> env.CARGO_REGISTRY_TOKEN = ${{ secrets.CARGO_REGISTRY_TOKEN }}
> run = '''
set -uo pipefail
publish() {
  local crate="$1" attempt out
  for attempt in $(seq 1 8); do
    if out=$(cargo publish -p "$crate" --allow-dirty 2>&1); then
      echo "$out"; return 0
    fi
    echo "$out"
    if echo "$out" | grep -qiE 'already (uploaded|exists)'; then
      echo "::notice::$crate already on crates.io — skipping"; return 0
    fi
    if echo "$out" | grep -qiE 'rate limit|too many|429|try again'; then
      echo "::warning::$crate rate-limited by crates.io (new-crate burst); waiting 11m for refill"
      sleep 660; continue
    fi
    echo "publish $crate failed (attempt $attempt); retrying in 30s (index propagation?)"
    sleep 30
  done
  echo "::error::failed to publish $crate after retries"; return 1
}
publish fig-kit
publish fig-core
publish fig-macros
publish fig
for dir in languages/*/; do
  publish "fig-$(basename "$dir")"
done

'''
