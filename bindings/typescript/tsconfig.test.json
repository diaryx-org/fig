// Type-check the test suite together with the sources. Nothing is emitted:
// `npm test` runs the `.ts` files directly under Node's strip-only TypeScript,
// which every construct here is written to satisfy (`erasableSyntaxOnly` in
// tsconfig.json holds the line), so this pass is only what stripping cannot
// do — check the types. `@types/node` is in devDependencies for the tests'
// `node:` imports.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    // `@diaryx/fig/helper` and `/kit` resolve to the sources rather than
    // `dist/` (the `fig-source` rows of package.json's exports, which
    // `npm test` passes to Node as well), and the kit and the JavaScript
    // languages are JavaScript, typed as written.
    "customConditions": ["fig-source"],
    // The language packages (`@diaryx/fig-<name>`, linked from the
    // repository's languages/) type themselves against `@diaryx/fig`, which
    // nothing above them in the tree installs: it is these sources.
    "paths": { "@diaryx/fig": ["./src/index.ts"] },
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
