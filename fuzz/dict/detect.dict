# Tokens libFuzzer splices into `detect`'s inputs, so mutation reaches the
# parser bodies instead of being rejected at the first byte: the structural
# characters fig's ten grammars branch on, and a few multi-byte openers.
nl="\x0a"
crlf="\x0d\x0a"
indent="  "
tab="\x09"
eq="="
colon=":"
colon_sp=": "
lbrack="["
rbrack="]"
dbl_lbrack="[["
lbrace="{"
rbrace="}"
quote="\""
squote="'"
triple_quote="\"\"\""
comma=","
lt="<"
gt=">"
hash="#"
dash="- "
dot="."
amp="&"
star="*"
bang="!"
backslash="\\"
pipe="|"
yaml_doc="---"
yaml_end="..."
xml_decl="<?xml version=\"1.0\"?>"
plist_open="<plist version=\"1.0\">"
dict_open="<dict>"
key_open="<key>"
string_open="<string>"
dotenv_export="export "
nt_text="> "
zon_dot=".{"
true="true"
false="false"
null="null"
