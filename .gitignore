/target
.zed
**/.DS_STORE
*.wasm
# The Diaryx app's historica store for this checkout: snapshots of the working
# tree as it stood, which can hold whatever was in it — the app's publish
# secrets once did.
history/
# The licence texts (and the `fig` crate's README) `cargo xtask vendor`
# copies in from the repo root for each published crate, and for each
# language's npm package.
languages/*/LICENSE-*
rust/*/LICENSE-*
bindings/rust/fig*/LICENSE-*
bindings/rust/fig/README.md
# A language package's JavaScript module, wrapped from its WebAssembly by
# its js/build.mjs.
languages/*/js/*.js
.env
