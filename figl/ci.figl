name = CI

# Build + test everything on every push/PR, as parallel jobs of one workflow:
#
#   * zig         — the core: zig build check (test + all-on + abi-check +
#                   semver-check + version-check). The one pre-release gate.
#   * rust        — cargo test for the Rust binding (bindings/rust).
#   * payload     — each payload crate links fig without Zig, per target.
#   * typescript  — build + test the TypeScript/npm binding (bindings/typescript).
#   * wasi        — build + test the fig-wasi npm package (bindings/wasi).
#
# These were once three separate workflows (ci.figl, ci-rust.figl, ci-npm.figl)
# so each binding could be re-triggered on its own; they were merged back into
# this single workflow so a push shows one CI status rather than three. The jobs
# still run independently and in parallel (no `needs` between them) — a slow or
# failing binding job doesn't hold up the others — but they now share one
# workflow run and one concurrency group, so a newer push cancels the whole set.
on
> workflow_dispatch = {}
> push.branches = [main]
> pull_request.branches = [main]

# A newer push to the same branch/PR supersedes any in-flight run — the whole
# workflow (every job below), since they now share this one group.
concurrency = { group = "ci-${{ github.ref }}", cancel-in-progress = true }

jobs.zig
> name = Zig — check (test + abi/semver/version guards)
> runs-on = ubuntu-latest

jobs.zig.steps[]
> uses = actions/checkout@v7
> # semver-check diffs the C ABI against the most recent release tag (`v*`,
> # or `core/v*` before the first one-version tag) via `git describe`/`git
> # show`, so it needs full history + tags, not the default shallow checkout.
> with.fetch-depth = 0
+
> uses = mlugg/setup-zig@v2
> with.version = 0.17.0
+
> # The one pre-release gate: zig test + all-on + abi-check + semver-check
> # + version-check. `check` also folds in the Rust/TS test suites, but
> # those degrade gracefully — with no cargo/npm toolchain in this job they
> # skip with a note, and the `rust` / `typescript` jobs below run
> # them for real (in parallel, with their pinned toolchains). See VERSIONING.md.
> #
> # `all-on` runs the tests again with every format compiled in. The
> # conformance corpora are not here: they live in fig-conformance. Fuzzing
> # has no natural stopping point, so it runs nightly (fuzz.figl) rather than
> # on the critical path.
> run = zig build check

jobs.rust
> name = Rust — cargo test
> runs-on = ubuntu-latest

jobs.rust.steps[]
> uses = actions/checkout@v7
+
> # build.rs compiles the fig core with `zig build`, so Zig is required here
> # even though this is a Rust job.
> uses = mlugg/setup-zig@v2
> with.version = 0.17.0
+
> uses = dtolnay/rust-toolchain@stable
+
> uses = Swatinem/rust-cache@v2
> with.workspaces = bindings/rust
+
> # --all-features so the serde- and derive-gated integration tests
> # (deserialize/serialize/edit/derive) run — none are in the default feature
> # set, so a plain `cargo test` would silently skip them.
> run = cargo test --workspace --all-features
> working-directory = bindings/rust

# A payload crate (bindings/rust/fig-sys-<key>) carries the prebuilt core and
# every language's library for one target, so a Rust program there needs no
# Zig. The `rust` job above builds from source in the checkout and never links
# a payload, and the release only builds them, on one macOS runner, just
# before publishing: so nothing showed that a payload's archives link on the
# target they are for. A broken one (the wasm core stopped building for a
# month in 2026, unnoticed) would surface as a failed release or a user's
# link error. This runs scripts/check-payload.sh for each target the host can
# link: it builds the payload, shadows Zig with a `zig` that fails, links
# fig's `wasm_smoke` example (fig and every language crate) from the payload
# alone, and runs it where the runner can. Android is linked with the NDK
# the runner image carries and not run: its programs need Android's loader.
#
# Here and not only in the release, because a release is the worst place for
# a check's first run (see the wasi job below).
jobs.payload
> name = "Rust — payload ${{ matrix.key }} links without Zig"
> runs-on = "${{ matrix.os }}"
> strategy.fail-fast = false

jobs.payload.strategy.matrix.include[]
> key = macos-x64
> os = macos-latest
> target = x86_64-apple-darwin
> # The arm64 runner runs an x86_64 program under Rosetta.
> run = arch -x86_64
+
> key = linux-x64-musl
> os = ubuntu-latest
> target = x86_64-unknown-linux-musl
> run = ""
+
> key = linux-arm64-musl
> os = ubuntu-24.04-arm
> target = aarch64-unknown-linux-musl
> run = ""
+
> key = android-arm64
> os = ubuntu-latest
> target = aarch64-linux-android
> run = "-"
+
> key = android-x64
> os = ubuntu-latest
> target = x86_64-linux-android
> run = "-"
+
> # Linked, not run: the core and the languages each compile for iOS apart
> # from macOS, and a release found the languages' did not.
> key = ios-arm64
> os = macos-latest
> target = aarch64-apple-ios
> run = "-"
+
> key = wasm32-wasi
> os = ubuntu-latest
> target = wasm32-wasip1
> run = wasmtime run

jobs.payload.steps[]
> uses = actions/checkout@v7
+
> # Builds the payload's archives; the link after it must not call Zig.
> uses = mlugg/setup-zig@v2
> with.version = 0.17.0
+
> uses = dtolnay/rust-toolchain@stable
> with.targets = "${{ matrix.target }}"
+
> uses = Swatinem/rust-cache@v2
> with.workspaces = bindings/rust
> with.key = "${{ matrix.key }}"
+
> if = "matrix.key == 'wasm32-wasi'"
> uses = bytecodealliance/actions/wasmtime/setup@v1
+
> # Cargo links Android with the host's `cc` unless told otherwise; the
> # runner image carries an NDK, whose clang names the API level.
> name = Link Android with the NDK
> if = "startsWith(matrix.key, 'android')"
> run = '''
set -euo pipefail
target="${{ matrix.target }}"
var="CARGO_TARGET_$(printf '%s' "$target" | tr '[:lower:]-' '[:upper:]_')_LINKER"
echo "$var=$ANDROID_NDK_LATEST_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/${target}24-clang" >> "$GITHUB_ENV"
'''
+
> run = "bash scripts/check-payload.sh ${{ matrix.key }} \"${{ matrix.run }}\""
> working-directory = bindings/rust

jobs.rust-port
> name = Rust port — cargo test + edit fixtures (no Zig)
> runs-on = ubuntu-latest

jobs.rust-port.steps[]
> uses = actions/checkout@v7
+
> # The port in rust/ is pure Rust: no Zig here, by design
> # (docs/proposals/rust-core.md).
> uses = dtolnay/rust-toolchain@stable
+
> uses = Swatinem/rust-cache@v2
> with.workspaces = rust
+
> run = cargo test --workspace
> working-directory = rust
+
> run = cargo build --release -p fig-conform
> working-directory = rust
+
> # Every language's hand-written edit fixtures, through the Rust editor
> # behind fig-conformance's adapter protocol.
> run = node tools/edit-fixtures.mjs --command rust/target/release/fig-conform

jobs.typescript
> name = TypeScript — build + test
> runs-on = ubuntu-latest

jobs.typescript.steps[]
> uses = actions/checkout@v7
+
> # `npm run build` runs `zig build wasm` to (re)generate the embedded module.
> uses = mlugg/setup-zig@v2
> with.version = 0.17.0
+
> uses = actions/setup-node@v7
> with
> > # Node 24+ for the tests, not for the package (engines is >=22): the
> > # suite runs its .ts files under Node's built-in type stripping and
> > # uses `using` (explicit resource management), which Node has from 24.
> > node-version = 24
> > cache = npm
> > cache-dependency-path = bindings/typescript/package-lock.json
+
> run = npm ci
> working-directory = bindings/typescript
+
> run = npm run build
> working-directory = bindings/typescript
+
> run = npm test
> working-directory = bindings/typescript

# fig-wasi is the CLI's WASI build wrapped as an npx-able npm package. It had no
# CI job until now, and its test suite ran in exactly one place: `prepublishOnly`
# on the release workflow. That is the worst place for the only run of a test to
# be. A missing-file assertion in it pinned the CLI's old raw-Zig-error wording,
# the CLI switched to human messages a fortnight later, and nothing noticed —
# because nothing ran it — until it failed the RELEASE, twice (cli/v3.5.4 and
# cli/v3.6.0). Both times the tap and the binaries published and fig-wasi did
# not, leaving the package two versions behind on npm.
#
# So it runs here too, on every push, where a rotted assertion fails a build
# instead of a publish. `prepublishOnly` still runs it at release time — this
# job does not replace that gate, it just stops that gate being the first time
# anyone finds out.
jobs.wasi
> name = fig-wasi — build + test
> runs-on = ubuntu-latest

jobs.wasi.steps[]
> uses = actions/checkout@v7
+
> # `npm run build` runs `zig build wasi` to (re)generate wasm/fig-wasi.wasm.
> uses = mlugg/setup-zig@v2
> with.version = 0.17.0
+
> uses = actions/setup-node@v7
> with
> > # The package itself declares `engines.node >= 20`, but the suite drives the
> > # guest through node:wasi, whose API has moved under us before; test on the
> > # same major the TypeScript job uses so both bindings fail together rather
> > # than one aging out quietly.
> > node-version = 24
> > cache = npm
> > cache-dependency-path = bindings/wasi/package-lock.json
+
> run = npm ci
> working-directory = bindings/wasi
+
> run = npm run build
> working-directory = bindings/wasi
+
> run = npm test
> working-directory = bindings/wasi
