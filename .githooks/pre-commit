#!/bin/sh
# Pre-commit: keep the C ABI surface and fig's one version consistent.
# Each check runs only when files it cares about are part of this commit, so a
# commit that touches neither pays nothing. Bypass with `git commit --no-verify`.
#
# The policy these enforce is the *code*, not VERSIONING.md (which just describes
# it): rust/xtask's abi-check and version-sync are the source of truth, run here
# and in CI. This shim is the one piece that must stay shell — a git hook is
# exec'd as a program — so the logic lives behind `cargo xtask <task>` and this
# just dispatches to it.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACM)

# C ABI symbol/header consistency when the implementation or header is staged.
case "$staged" in
    *rust/fig-capi/* | *rust/fig-abi/* | *rust/fig-kit-capi/* | *bindings/c/include/fig.h*)
        printf 'pre-commit: C ABI files staged — running abi-check\n'
        ( cd "$root" && cargo xtask abi-check ) || {
            printf 'pre-commit: abi-check failed; commit aborted (use --no-verify to bypass)\n' >&2
            exit 1
        }
        ;;
esac

# Every file carrying fig's one version agrees with the workspace's Cargo.toml,
# when any of them is staged. Cheap and tag-independent, unlike semver-check (a
# release gate that needs git tags), which stays CI-only.
case "$staged" in
    *Cargo.toml* | *bindings/c/include/fig.h* | *README.md* | *package.json* | *package-lock.json* | *bindings/nushell/Cargo.lock*)
        printf 'pre-commit: version-bearing file staged — running version-check\n'
        ( cd "$root" && cargo xtask version-check ) || {
            printf 'pre-commit: version-check failed; run `cargo xtask version-sync` and stage the result (use --no-verify to bypass)\n' >&2
            exit 1
        }
        ;;
esac
