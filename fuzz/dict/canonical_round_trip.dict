# Tokens libFuzzer splices into `canonical_round_trip`'s inputs: the
# canonical grammar's own, a closed JSON-like syntax, so the line-oriented
# and XML tokens `detect` uses would only be noise here.
quote="\""
lbrace="{"
rbrace="}"
lbrack="["
rbrack="]"
colon=":"
comma=","
nl="\x0a"
line_comment="//"
block_open="/*"
block_close="*/"
anchor="&a "
alias="*a"
tag="!!str "
override_int="~i"
override_float="~f"
offset_datetime="@offset_datetime "
local_datetime="@local_datetime "
local_date="@local_date "
local_time="@local_time "
enum_literal="@enum_literal "
char_literal="@char_literal "
number_special="@number_special "
escape_u="\\u"
escape_quote="\\\""
true="true"
false="false"
null="null"
plist_date="@plist_date "
data="@data "
