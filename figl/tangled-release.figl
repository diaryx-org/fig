engine = microvm

# Tangled release — cross-compile the `fig` CLI for every target and attach
# each build to the tag as a tangled *artifact*, the equivalent of the assets
# `.github/workflows/release-binaries.yml` + `homebrew.yml` attach to a GitHub
# Release. An artifact is an ATProto record (`sh.tangled.repo.artifact`) in the
# repo owner's PDS whose blob is the file and whose `tag` field is the
# annotated tag's object hash, so tangled shows it on that tag's page.
#
# Fires on the same `cli/v*.*.*` tag as the two GitHub workflows above — see
# "Release tagging" in docs/VERSIONING.md for the whole per-artifact tag
# scheme; this one ships CLI binaries, so it watches the CLI's own line. Every
# target is cross-compiled from this one x86_64 NixOS microVM: Zig's
# self-contained cross-compilation needs no per-target runner, no Docker, no
# QEMU.
#
# Two prerequisites, once, on the tangled side. A spindle has to be attached to
# the repo (Settings → Pipelines), same as CI; and `ATP_APP_PASSWORD` has to be
# set under Settings → Secrets — an app password (NOT the account password) for
# the account that owns this repo. Everything else the publish step needs —
# which DID to write to, which PDS that DID lives on, the repo URL — is
# discovered at run time, so that secret is the only thing to configure.
#
# Note that this publishes; it does not reconcile. A re-run on the same tag
# creates a *second* record per artifact rather than replacing the first, so
# delete the old records by hand before re-running a release.
image = nixos

when[]
> event = [push]
> tag = [cli/v*.*.*]

# `git` for the tag object, `curl`/`gnutar`/`xz` for the toolchain tarball and
# the XRPC calls, `gzip`/`zip` to pack the binaries, `jq` to build the record
# JSON. No `zig` — see the install step in figl/tangled-ci.figl for why the
# toolchain comes from ziglang.org rather than from nixpkgs.
dependencies = [git, curl, gnutar, xz, gzip, zip, jq]

steps[]
> # `git rev-parse <tag>^{tag}` below needs the annotated tag object itself,
> # not just the commit it points at.
> name = Fetch tags
> command = git fetch --tags --force --unshallow 2>/dev/null || git fetch --tags --force || true
+
> # Identical to figl/tangled-ci.figl's install step — the toolchain version
> # comes from `minimum_zig_version` in build.zig.zon so there is no third
> # pin to bump, and Zig's static Linux tarball runs as-is on NixOS.
> name = Install the pinned Zig toolchain
> command = '''
set -euo pipefail
version=$(sed -n 's/.*minimum_zig_version = "\([^"]*\)".*/\1/p' build.zig.zon)
[ -n "$version" ] || { echo "could not read minimum_zig_version from build.zig.zon" >&2; exit 1; }
echo "zig $version (from build.zig.zon)"
mkdir -p .zig
curl -fsSL "https://ziglang.org/download/$version/zig-x86_64-linux-$version.tar.xz" \
  | tar -xJ --strip-components=1 -C .zig
.zig/zig version

'''
+
> # The same set the GitHub release ships, from one runner: the four Unix
> # tarballs, the Windows zip, the WASI module, and `build_options.zig` — a
> # *source* file `zig build` normally generates in-cache, which a Zig hosted
> # on wasm32-wasi has no build runner to produce, so it rides along with the
> # .wasm (see the `wasi-options` step in build.zig). fig-wasi's
> # optimize/strip are hardcoded in build.zig, hence no -D flags on that one.
> #
> # The Linux pair is built against musl rather than glibc — fig links libc,
> # and these tarballs are downloaded and run directly (no package manager to
> # resolve a glibc dependency), so a static binary that runs on any distro
> # beats one tied to the builder's glibc. The archive names drop the `-musl`:
> # it is a property of the build, not a target the user chooses between.
> # `zig build` installs `fig-lsp` alongside `fig`; only `fig` is packaged,
> # matching what the GitHub release attaches.
> name = Build the release binaries
> command = '''
set -euo pipefail
export PATH="$PWD/.zig:$PATH"
root="$PWD"
mkdir -p dist

for spec in x86_64-linux-musl:x86_64-linux aarch64-linux-musl:aarch64-linux \
            aarch64-macos:aarch64-macos x86_64-macos:x86_64-macos; do
  target=${spec%%:*}
  name=${spec##*:}
  zig build -Doptimize=ReleaseFast -Dstrip=true -Dtarget="$target" --prefix "zig-out/$name"
  tar -czf "dist/fig-$name.tar.gz" -C "zig-out/$name/bin" fig
done

zig build -Doptimize=ReleaseFast -Dstrip=true -Dtarget=x86_64-windows --prefix zig-out/x86_64-windows
( cd zig-out/x86_64-windows/bin && zip -qj "$root/dist/fig-x86_64-windows.zip" fig.exe )

zig build wasi --prefix zig-out/wasi
cp zig-out/wasi/bin/fig-wasi.wasm dist/fig-wasi.wasm

zig build wasi-options --prefix zig-out/wasi-options
cp zig-out/wasi-options/build_options.zig dist/build_options.zig

ls -l dist

'''
+
> # One `sh.tangled.repo.artifact` record per file in dist/, following the
> # recipe in https://docs.tangled.org/spindles — with the PDS resolved from
> # the DID document instead of hardcoded, so this keeps working whichever PDS
> # the owning account lives on (and if it ever migrates).
> #
> # `TANGLED_REPO_DID`, `TANGLED_REPO_NAME` and `TANGLED_REF_NAME` are supplied
> # by spindle; `ATP_APP_PASSWORD` comes from Settings → Secrets. The record's
> # `tag` is the annotated tag *object's* hash as raw bytes — which is why the
> # release tags this repo pushes have to stay annotated (`git tag -a`), as
> # every existing one is.
> #
> # The `repo` field is the AT-URI of the repo's own `sh.tangled.repo` record,
> # NOT `TANGLED_REPO_URL`. The docs recipe passes the latter, but the
> # sh.tangled.repo.artifact lexicon declares `repo` as `format: at-uri` and
> # spindle sets `TANGLED_REPO_URL` to the knot's https URL, so the recipe
> # writes a record the appview will never match to this repo — and because
> # `validate: false` (also from the recipe) skips lexicon checking, the PDS
> # accepts it, createRecord returns 200, and the release *looks* successful
> # while nothing shows up on the tag page. The first cli/v3.5.4 run did
> # exactly that. The AT-URI is rebuilt here from spindle's own variables: the
> # repo record's rkey is the repo name.
> name = Publish the artifacts to the tag
> command = '''
set -euo pipefail
: "${ATP_APP_PASSWORD:?set an app password under Settings → Secrets}"

did="$TANGLED_REPO_DID"
case "$did" in
  did:plc:*) doc=$(curl -fsSL "https://plc.directory/$did") ;;
  did:web:*) doc=$(curl -fsSL "https://${did#did:web:}/.well-known/did.json") ;;
  *) echo "unsupported DID method: $did" >&2; exit 1 ;;
esac
pds=$(printf '%s' "$doc" | jq -r 'first(.service[]? | select(.id | endswith("atproto_pds")) | .serviceEndpoint) // empty')
[ -n "$pds" ] || { echo "no atproto_pds service in the DID document for $did" >&2; exit 1; }
echo "publishing as $did via $pds"

session=$(curl -fsS -X POST "$pds/xrpc/com.atproto.server.createSession" \
  -H "Content-Type: application/json" \
  -d "$(jq -n --arg id "$did" --arg pw "$ATP_APP_PASSWORD" '{identifier:$id,password:$pw}')")
jwt=$(printf '%s' "$session" | jq -r .accessJwt)
repo=$(printf '%s' "$session" | jq -r .did)

tag_hash=$(git rev-parse "$TANGLED_REF_NAME^{tag}")
tag_bytes=$(printf "$(printf '%s' "$tag_hash" | sed 's/../\\x&/g')" | base64 | tr -d '=\n')
created=$(date -Iseconds)
repo_uri="at://$TANGLED_REPO_DID/sh.tangled.repo/$TANGLED_REPO_NAME"
echo "attaching to $repo_uri at tag $TANGLED_REF_NAME ($tag_hash)"

for path in dist/*; do
  name=$(basename "$path")
  blob=$(curl -fsS -X POST "$pds/xrpc/com.atproto.repo.uploadBlob" \
    -H "Authorization: Bearer $jwt" \
    -H "Content-Type: application/octet-stream" \
    --data-binary @"$path")
  record=$(jq -n \
    --arg repo "$repo" \
    --arg tag "$tag_bytes" \
    --arg name "$name" \
    --arg uri "$repo_uri" \
    --arg created "$created" \
    --argjson blob "$(printf '%s' "$blob" | jq .blob)" '{
      repo: $repo,
      collection: "sh.tangled.repo.artifact",
      validate: false,
      record: {
        "$type": "sh.tangled.repo.artifact",
        tag: {"$bytes": $tag},
        name: $name,
        repo: $uri,
        repoDid: $repo,
        artifact: $blob,
        createdAt: $created
      }
    }')
  curl -fsS -X POST "$pds/xrpc/com.atproto.repo.createRecord" \
    -H "Authorization: Bearer $jwt" \
    -H "Content-Type: application/json" \
    -d "$record" > /dev/null
  echo "published $name"
done

'''
