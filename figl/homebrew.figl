name = Homebrew

# Release the `fig` CLI to Homebrew. The build/attach/render/push mechanics are
# shared with twig and moid and live in the reusable workflow at
# diaryx-org/.github; only what makes fig different is below.
#
# Linux binaries come from this workflow (not release-binaries.yml) because
# bump-formula needs them ready in the same run, via `needs:`, before it
# downloads them to compute checksums — two independent workflows triggered by
# the same tag have no ordering guarantee between them. Windows + WASI binaries
# have no such downstream dependency, so they stay in release-binaries.yml. The
# crates.io crate is release.yml; the two npm packages are release-npm.yml and
# release-npm-wasi.yml.
#
# Runs on the `v*.*.*` tag — one tag releases every artifact (see "Release
# tagging" in docs/VERSIONING.md), so this is the reusable workflow's default
# `v` prefix and needs no `tag-prefix`.
#
# Prerequisites before the first tagged release succeeds:
# 1. Create the tap repo `diaryx-org/homebrew-tap` (already done).
# 2. Install the diaryx-bot GitHub App on the tap (Contents:write) and add its
# App ID + private key as the TAP_APP_ID / TAP_APP_KEY secrets on this repo
# (already done). The bump-formula job mints a short-lived token from these.
on
> push.tags = [v*.*.*]
> workflow_dispatch = null

permissions.contents = write # caps what the called workflow may request

jobs.homebrew
> uses = diaryx-org/.github/.github/workflows/reusable-homebrew.yml@main
> with
> > name = fig
> > desc = Parse, edit, and convert config files while preserving comments. Supports JSON, YAML, TOML, and more.
> > language = zig
> > zig-flags = -Doptimize=ReleaseFast -Dstrip=true
> secrets
> > TAP_APP_ID = ${{ secrets.TAP_APP_ID }}
> > TAP_APP_KEY = ${{ secrets.TAP_APP_KEY }}
