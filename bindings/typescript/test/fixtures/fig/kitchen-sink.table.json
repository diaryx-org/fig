node":255,"start":6525,"end":6577},{"node":261,"start":6674,"end":6741},{"node":262,"start":6674,"end":6741},{"node":269,"start":6762,"end":6838},{"node":278,"start":6940,"end":6945},{"node":345,"start":8060,"end":8072},{"node":358,"start":8455,"end":8462},{"node":363,"start":8628,"end":8633},{"node":372,"start":9346,"end":9354}],"mentions":[{"node":3,"span":[1109,1117],"kind":"entry"},{"node":12,"span":[1293,1297],"kind":"entry"},{"node":21,"span":[1517,1522],"kind":"entry"},{"node":24,"span":[1525,1530],"kind":"entry"},{"node":33,"span":[1810,1814],"kind":"entry"},{"node":36,"span":[1815,1821],"kind":"entry"},{"node":39,"span":[1822,1828],"kind":"entry"},{"node":51,"span":[2116,2122],"kind":"entry"},{"node":66,"span":[2368,2374],"kind":"entry"},{"node":129,"span":[3794,3801],"kind":"entry"},{"node":144,"span":[4125,4130],"kind":"entry"},{"node":156,"span":[4595,4602],"kind":"entry"},{"node":166,"span":[4721,4729],"kind":"entry"},{"node":184,"span":[5024,5029],"kind":"entry"},{"node":190,"span":[5104,5111],"kind":"entry"},{"node":195,"span":[5266,5274],"kind":"entry"},{"node":198,"span":[5275,5278],"kind":"entry"},{"node":201,"span":[5279,5287],"kind":"entry"},{"node":210,"span":[5808,5812],"kind":"entry"},{"node":213,"span":[5813,5817],"kind":"entry"},{"node":219,"span":[5854,5859],"kind":"entry"},{"node":226,"span":[5940,5944],"kind":"entry"},{"node":236,"span":[6270,6274],"kind":"entry"},{"node":239,"span":[6275,6285],"kind":"entry"},{"node":246,"span":[6353,6358],"kind":"entry"},{"node":261,"span":[6674,6682],"kind":"entry"},{"node":278,"span":[6940,6944],"kind":"entry"},{"node":345,"span":[8060,8071],"kind":"entry"},{"node":358,"span":[8455,8461],"kind":"entry"},{"node":363,"span":[8628,8632],"kind":"entry"},{"node":372,"span":[9346,9353],"kind":"entry"}],"comments":[{"node":2,"slot":"leading","style":"line","text":"─────────────────────────────────────────────────────────────"},{"node":2,"slot":"leading","style":"line","text":"fig authoring dialect — kitchen-sink example"},{"node":2,"slot":"leading","style":"line","text":"Exercises every feature in DESIGN.md, in ONE valid document."},{"node":2,"slot":"leading","style":"line","text":""},{"node":2,"slot":"leading","style":"line","text":"House style (settled): depth = count of leading `>`, written as a SPACED"},{"node":2,"slot":"leading","style":"line","text":"run (`> >`, not `>>`) with ZERO leading indentation — the spaced run"},{"node":2,"slot":"leading","style":"line","text":"rebuilds the visual ruler out of the markers themselves, so no second"},{"node":2,"slot":"leading","style":"line","text":"(indentation) signal needs to be kept in sync by hand. Meaning lives"},{"node":2,"slot":"leading","style":"line","text":"entirely in the `>` count; indentation is opt-in (`fig fmt --indent`) and"},{"node":2,"slot":"leading","style":"line","text":"is not used here. A couple of lines below deliberately use the glued"},{"node":2,"slot":"leading","style":"line","text":"(`>>>`) or unspaced (`>*`) spellings on purpose, to show the parser"},{"node":2,"slot":"leading","style":"line","text":"accepts both — see the note in the \"Sequences\" section."},{"node":2,"slot":"leading","style":"line","text":"─────────────────────────────────────────────────────────────"},{"node":2,"slot":"leading","style":"line","text":"=== Containers, assignments, prefix-count depth ==="},{"node":3,"slot":"trailing","style":"line","text":"container header (bare word, no `=`)"},{"node":6,"slot":"trailing","style":"line","text":"database.host"},{"node":9,"slot":"trailing","style":"line","text":"database.port  (bare number)"},{"node":12,"slot":"trailing","style":"line","text":"nested container header"},{"node":15,"slot":"trailing","style":"line","text":"database.pool.size"},{"node":18,"slot":"trailing","style":"line","text":"database.pool.timeout"},{"node":20,"slot":"leading","style":"line","text":"=== Dotted-key flattener (flatten within one line) ==="},{"node":27,"slot":"trailing","style":"line","text":"cache.redis.host  (IP → string, 3 dots)"},{"node":30,"slot":"trailing","style":"line","text":"cache.redis.port"},{"node":41,"slot":"leading","style":"line","text":"A chain of single-child maps collapses to ONE dotted line under `fig fmt`"},{"node":41,"slot":"leading","style":"line","text":"(the printer's mirror of the flattener above — see \"What fig fmt normalizes\"):"},{"node":42,"slot":"trailing","style":"line","text":"deep.nested.single.value"},{"node":44,"slot":"leading","style":"line","text":"=== Root-level assignments (zero markers, zero indent) ==="},{"node":45,"slot":"trailing","style":"line","text":"a plain key in the root map"},{"node":48,"slot":"trailing","style":"line","text":"bare string, spaces and all"},{"node":50,"slot":"leading","style":"line","text":"=== Explicit typing:  key: type = value  (optional) ==="},{"node":54,"slot":"trailing","style":"line","text":"annotated (vs inferred)"},{"node":57,"slot":"trailing","style":"line","text":"bare string with spaces"},{"node":60,"slot":"trailing","style":"line","text":"enum atom (explicit-typing-only)"},{"node":65,"slot":"leading","style":"line","text":"=== Values: literal-else-string ==="},{"node":69,"slot":"trailing","style":"line","text":"int"},{"node":72,"slot":"trailing","style":"line","text":"float"},{"node":75,"slot":"trailing","style":"line","text":"hex int lexeme"},{"node":78,"slot":"trailing","style":"line","text":"float with exponent"},{"node":81,"slot":"trailing","style":"line","text":"float — lexeme kept VERBATIM; not collapsed to 1.1"},{"node":84,"slot":"trailing","style":"line","text":"float — a distinct lexeme from 100.0 (numeric identity = lexeme identity)"},{"node":87,"slot":"trailing","style":"line","text":"bool (lowercase only)"},{"node":90,"slot":"trailing","style":"line","text":"null"},{"node":93,"slot":"trailing","style":"line","text":"STRING — quotes override the bool literal"},{"node":96,"slot":"trailing","style":"line","text":"STRING — doesn't fully parse as a number"},{"node":99,"slot":"trailing","style":"line","text":"STRING — three components, not a clean number (so it's NOT mangled)"},{"node":102,"slot":"trailing","style":"line","text":"STRING — \"Yes\"/\"on\"/\"TRUE\" are never bools"},{"node":105,"slot":"trailing","style":"line","text":"STRING — leading zero != number; padding kept"},{"node":108,"slot":"trailing","style":"line","text":"STRING — quote to override the int literal"},{"node":111,"slot":"trailing","style":"line","text":"enum atom (explicit-typing-only)"},{"node":114,"slot":"trailing","style":"line","text":"datetime (RFC-3339, self-identifying)"},{"node":117,"slot":"trailing","style":"line","text":"date (RFC-3339 full-date)"},{"node":120,"slot":"trailing","style":"line","text":"time (RFC-3339 partial-time, self-identifying)"},{"node":123,"slot":"trailing","style":"line","text":"non-finite: explicit-typing-only"},{"node":126,"slot":"trailing","style":"line","text":"bare inf/nan would be plain strings"},{"node":128,"slot":"leading","style":"line","text":"=== Quotes:  '' raw/literal   \"\"  escaped ==="},{"node":132,"slot":"trailing","style":"line","text":"single quotes: backslashes stay literal"},{"node":135,"slot":"trailing","style":"line","text":"double quotes: \\n \\t \\uXXXX honored"},{"node":141,"slot":"trailing","style":"line","text":"key with a literal dot MUST be quoted"},{"node":143,"slot":"leading","style":"line","text":"=== Comment marker (#) only after whitespace — URLs survive ==="},{"node":147,"slot":"trailing","style":"line","text":"the // in the URL stays in the value"},{"node":150,"slot":"trailing","style":"line","text":"comment starts here; value ends before it"},{"node":153,"slot":"trailing","style":"line","text":"#stable has no leading space -> kept"},{"node":155,"slot":"leading","style":"line","text":"=== Sequences — form A2 (`*` is an anonymous positional key) ==="},{"node":155,"slot":"leading","style":"line","text":"The element `*` sits in key position after the run: `> *` (normalized), `>*`"},{"node":155,"slot":"leading","style":"line","text":"(glued) — both appear below on purpose. YAML's `-` is a hard error."},{"node":157,"slot":"trailing","style":"line","text":"first element (a map): fields one level deeper"},{"node":166,"slot":"trailing","style":"line","text":"nested list field"},{"node":167,"slot":"trailing","style":"line","text":"spaced form (normalized)"},{"node":174,"slot":"trailing","style":"line","text":"glued form — parses identically to `> > >  *`"},{"node":178,"slot":"trailing","style":"line","text":"second element"},{"node":184,"slot":"trailing","style":"line","text":"scalar elements"},{"node":190,"slot":"trailing","style":"line","text":"typing composes with `*`"},{"node":200,"slot":"leading","style":"line","text":"=== Dotted section header — re-anchors baseline (like TOML [a.b.c]) ==="},{"node":201,"slot":"trailing","style":"line","text":"selects/creates services.web.frontend"},{"node":204,"slot":"trailing","style":"line","text":"services.web.frontend.replicas (depth is RELATIVE)"},{"node":207,"slot":"trailing","style":"line","text":"':' in a value is fine -> bare string"},{"node":212,"slot":"leading","style":"line","text":"=== Appending sequence headers — primary surface for nested lists of maps ==="},{"node":212,"slot":"leading","style":"line","text":"`a.b[]` appends an element to sequence a.b and re-anchors; fields stay 1 deep"},{"node":212,"slot":"leading","style":"line","text":"no matter how deep the LIST nests. Edit-stable (append, not index). A `+`"},{"node":212,"slot":"leading","style":"line","text":"line re-runs the most recent zero-marker `[]` header without retyping it."},{"node":220,"slot":"trailing","style":"line","text":"append a step, re-anchor here"},{"node":230,"slot":"trailing","style":"line","text":"same as repeating `jobs.test.steps[]`"},{"node":240,"slot":"leading","style":"line","text":"Nested lists of lists: a non-final `[]` means \"the last element\" — only the"},{"node":240,"slot":"leading","style":"line","text":"final `[]` in the path appends. So `spec.containers[].ports[]` appends a"},{"node":240,"slot":"leading","style":"line","text":"port to the LAST container, and `+` re-runs the whole path."},{"node":240,"slot":"trailing","style":"line","text":"append a container"},{"node":247,"slot":"trailing","style":"line","text":"last container -> append a port"},{"node":251,"slot":"trailing","style":"line","text":"same path again -> another port, same container"},{"node":255,"slot":"trailing","style":"line","text":"a second container"},{"node":264,"slot":"leading","style":"line","text":"=== Index addressing — for editing an EXISTING element (edit-fragile) ==="},{"node":265,"slot":"trailing","style":"line","text":"clusters is a sequence; element 0"},{"node":272,"slot":"trailing","style":"line","text":"element 1 (skipping [1] would be an error)"},{"node":277,"slot":"leading","style":"line","text":"=== Flow mode — value starting with [ or { (fig-inline OR pasted JSON) ==="},{"node":281,"slot":"trailing","style":"line","text":"fig-inline: bare strings"},{"node":287,"slot":"trailing","style":"line","text":"bare values keep spaces"},{"node":293,"slot":"trailing","style":"line","text":"fig-inline object: `=` pairs, bare keys"},{"node":302,"slot":"trailing","style":"line","text":"JSON object: `:` pairs, quoted keys"},{"node":313,"slot":"trailing","style":"line","text":"JSONC: trailing comma (and `#` comments) OK"},{"node":319,"slot":"trailing","style":"line","text":"nested"},{"node":339,"slot":"trailing","style":"line","text":"required spelling for an empty sequence"},{"node":342,"slot":"trailing","style":"line","text":"required spelling for an empty map"},{"node":344,"slot":"leading","style":"line","text":"=== Multi-line flow for long lists (the frontmatter surface) ==="},{"node":344,"slot":"leading","style":"line","text":"A fully flow-representable sequence with no map elements stacks one element"},{"node":344,"slot":"leading","style":"line","text":"per line, trailing comma, when it overflows the width budget or exceeds the"},{"node":344,"slot":"leading","style":"line","text":"item-count threshold (default 6) — the terse spelling for frontmatter-style"},{"node":344,"slot":"leading","style":"line","text":"link/tag lists. Still one assignment, so it isn't blank-line separated."},{"node":357,"slot":"leading","style":"line","text":"=== Quote-avoidance: bare beats quoted when a broken list would need quotes ==="},{"node":357,"slot":"leading","style":"line","text":"Flow would force quotes here (each element has a top-level comma, which"},{"node":357,"slot":"leading","style":"line","text":"terminates a bare flow value); the `> *` block form keeps them bare instead,"},{"node":357,"slot":"leading","style":"line","text":"since a comma is ordinary text in a block bare string."},{"node":362,"slot":"leading","style":"line","text":"=== Multiline strings — two flavors ==="},{"node":366,"slot":"trailing","style":"line","text":"'' raw/verbatim: no escapes, whitespace exact"},{"node":368,"slot":"leading","style":"line","text":"^ raw content is flush-left ON PURPOSE: in a raw block leading indentation"},{"node":368,"slot":"leading","style":"line","text":"becomes part of the value, so it opts out of the file's spaced-marker style."},{"node":369,"slot":"trailing","style":"line","text":"\"\" escaped + smart-dedent"},{"node":371,"slot":"leading","style":"line","text":"^ escaped content CAN be indented: the common leading indent (6 spaces here,"},{"node":371,"slot":"leading","style":"line","text":"including the closing \"\"\") is stripped, so the value is \"Welcome!\\nEnjoy…\"."},{"node":371,"slot":"leading","style":"line","text":"=== Comments ==="},{"node":371,"slot":"leading","style":"line","text":"A run of #-lines is one logical block comment; a printer may downgrade a"},{"node":371,"slot":"leading","style":"line","text":"stored block comment to exactly this shape."},{"node":374,"slot":"leading","style":"line","text":"a DEPTH-PREFIXED comment (note the `>`) attaches to the next sibling"},{"node":375,"slot":"trailing","style":"line","text":"inline comment (after whitespace)"}]}
