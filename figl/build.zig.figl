name: enum = fig
version = 6.1.0
license = MIT OR Apache-2.0
fingerprint = 0xd4f24a95e29f7b74 # Changing this has security and trust implications.
minimum_zig_version = 0.17.0
# The helper wire's JSON-RPC 2.0 envelope (docs/helper-protocol.md): a hard
# fork of zigjr, pinned by commit. Lazy, and only asked for with
# -Dhelper-wire (the default), so the Rust crate's C library, which has no
# helper wire, builds without fetching it.
dependencies.zigjr
> url = https://github.com/adammharris/zigjr/archive/a577cf0886822391a8f4915fa0579dca70b8a82d.tar.gz
> hash = zigjr-1.9.0-bESYopXUBgBsYrT_05pyx-gIFpa_lT-Ixb4j2yRCIczk
> lazy = true
# The kit, a package of its own: what core and every language share.
dependencies.fig_kit
> path = kit
# The languages fig ships, each a package of its own (languages/<name>/).
dependencies.fig_json
> path = languages/json
dependencies.fig_yaml
> path = languages/yaml
dependencies.fig_toml
> path = languages/toml
dependencies.fig_zon
> path = languages/zon
dependencies.fig_figl
> path = languages/figl
dependencies.fig_ini
> path = languages/ini
dependencies.fig_dotenv
> path = languages/dotenv
dependencies.fig_properties
> path = languages/properties
dependencies.fig_plist
> path = languages/plist
dependencies.fig_nestedtext
> path = languages/nestedtext
paths = [build.zig, build.zig.zon, src, kit, languages, README.md, LICENSE-MIT, LICENSE-APACHE]
