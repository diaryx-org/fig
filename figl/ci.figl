name = CI

# Build + test everything on every push/PR, as parallel jobs of one workflow:
#
#   * check       — `ship ci`, the one pre-release gate: the `job` list in
#                   .config/ship.figl — the workspace's tests, the edit
#                   fixtures, the CLI checks and the
#                   abi/semver/version/vendor/figl guards.
#   * cross       — the `fig` crate builds for each tier-1 target.
#   * typescript  — build + test the TypeScript/npm binding (bindings/typescript).
#   * wasi        — build + test the fig-wasi npm package (bindings/wasi).
#
# These were once three separate workflows (ci.figl, ci-rust.figl, ci-npm.figl)
# so each binding could be re-triggered on its own; they were merged back into
# this single workflow so a push shows one CI status rather than three. The jobs
# still run independently and in parallel (no `needs` between them) — a slow or
# failing binding job doesn't hold up the others — but they now share one
# workflow run and one concurrency group, so a newer push cancels the whole set.
on
> workflow_dispatch = {}
> push.branches = [main]
> pull_request.branches = [main]

# A newer push to the same branch/PR supersedes any in-flight run — the whole
# workflow (every job below), since they now share this one group.
concurrency = { group = "ci-${{ github.ref }}", cancel-in-progress = true }

# The name is the check's, which predates ship; it runs `ship ci` now.
jobs.check
> name = Rust — cargo xtask ci
> runs-on = ubuntu-latest

jobs.check.steps[]
> uses = actions/checkout@v7
> # semver-check diffs the C ABI against the most recent release tag via
> # `git describe`/`git show`, so it needs full history + tags, not the
> # default shallow checkout.
> with.fetch-depth = 0
+
> uses = dtolnay/rust-toolchain@stable
+
> uses = Swatinem/rust-cache@v2
+
> run = cargo install --locked --git https://github.com/diaryx-org/ship ship
+
> # The one pre-release gate (docs/VERSIONING.md): every job in
> # .config/ship.figl, in order — the workspace's tests with every feature on
> # and with each crate's defaults, the abi/semver/version/vendor/figl guards,
> # the CLI checks and the edit fixtures. It also folds in the TypeScript and
> # WASI suites, which skip with a note here, with no node_modules installed;
> # the `typescript` and `wasi` jobs below run them for real, in parallel.
> #
> # The conformance corpora are not here: they live in fig-conformance.
> # Fuzzing has no natural stopping point, so it runs nightly (fuzz.figl)
> # rather than on the critical path.
> run = ship ci

# The `fig` crate, its core (`fig-core`, `fig-kit`) and its language crates
# are pure Rust, so a program on any target builds them with no C toolchain.
# The `check` job builds for the host; this builds the `fig` crate for each
# tier-1 target fig once shipped a prebuilt payload for, so a target the
# crate stopped compiling for shows here, not in a user's build.
jobs.cross
> name = "Rust — fig builds for ${{ matrix.key }}"
> runs-on = "${{ matrix.os }}"
> strategy.fail-fast = false

jobs.cross.strategy.matrix.include[]
> key = macos-x64
> os = macos-latest
> target = x86_64-apple-darwin
+
> key = linux-x64-musl
> os = ubuntu-latest
> target = x86_64-unknown-linux-musl
+
> key = linux-arm64-musl
> os = ubuntu-24.04-arm
> target = aarch64-unknown-linux-musl
+
> key = android-arm64
> os = ubuntu-latest
> target = aarch64-linux-android
+
> key = android-x64
> os = ubuntu-latest
> target = x86_64-linux-android
+
> key = ios-arm64
> os = macos-latest
> target = aarch64-apple-ios
+
> key = wasm32-wasi
> os = ubuntu-latest
> target = wasm32-wasip1

jobs.cross.steps[]
> uses = actions/checkout@v7
+
> uses = dtolnay/rust-toolchain@stable
> with.targets = "${{ matrix.target }}"
+
> uses = Swatinem/rust-cache@v2
> with.key = "${{ matrix.key }}"
+
> run = "cargo build -p fig --target ${{ matrix.target }}"

jobs.typescript
> name = TypeScript — build + test
> runs-on = ubuntu-latest

jobs.typescript.steps[]
> uses = actions/checkout@v7
+
> # `npm run build` builds fig's wasm modules from the Rust workspace: the
> # core (fig-capi), the kit's rules and each language's own.
> uses = dtolnay/rust-toolchain@stable
> with.targets = wasm32-unknown-unknown
+
> uses = Swatinem/rust-cache@v2
> with.key = wasm
+
> uses = actions/setup-node@v7
> with
> > # Node 24+ for the tests, not for the package (engines is >=22): the
> > # suite runs its .ts files under Node's built-in type stripping and
> > # uses `using` (explicit resource management), which Node has from 24.
> > node-version = 24
> > cache = npm
> > cache-dependency-path = bindings/typescript/package-lock.json
+
> run = npm ci
> working-directory = bindings/typescript
+
> run = npm run build
> working-directory = bindings/typescript
+
> run = npm test
> working-directory = bindings/typescript
+
> # Every language's hand-written edit fixtures, through this binding and
> # the language modules `npm run build` made.
> run = node --conditions=fig-source ../../tools/edit-fixtures.mjs
> working-directory = bindings/typescript

# fig-wasi is the CLI's WASI build wrapped as an npx-able npm package. It had no
# CI job until now, and its test suite ran in exactly one place: `prepublishOnly`
# on the release workflow. That is the worst place for the only run of a test to
# be. A missing-file assertion in it pinned the CLI's old raw-error wording,
# the CLI switched to human messages a fortnight later, and nothing noticed —
# because nothing ran it — until it failed the RELEASE, twice (cli/v3.5.4 and
# cli/v3.6.0). Both times the tap and the binaries published and fig-wasi did
# not, leaving the package two versions behind on npm.
#
# So it runs here too, on every push, where a rotted assertion fails a build
# instead of a publish. `prepublishOnly` still runs it at release time — this
# job does not replace that gate, it just stops that gate being the first time
# anyone finds out.
jobs.wasi
> name = fig-wasi — build + test
> runs-on = ubuntu-latest

jobs.wasi.steps[]
> uses = actions/checkout@v7
+
> # `npm run build` builds fig's CLI for wasm32-wasip1 into
> # wasm/fig-wasi.wasm, and the kit's rules for the languages it serves.
> uses = dtolnay/rust-toolchain@stable
> with.targets = "wasm32-wasip1,wasm32-unknown-unknown"
+
> uses = Swatinem/rust-cache@v2
> with.key = wasi
+
> uses = actions/setup-node@v7
> with
> > # The package itself declares `engines.node >= 20`, but the suite drives the
> > # guest through node:wasi, whose API has moved under us before; test on the
> > # same major the TypeScript job uses so both bindings fail together rather
> > # than one aging out quietly.
> > node-version = 24
> > cache = npm
> > cache-dependency-path = bindings/wasi/package-lock.json
+
> run = npm ci
> working-directory = bindings/wasi
+
> run = npm run build
> working-directory = bindings/wasi
+
> run = npm test
> working-directory = bindings/wasi
